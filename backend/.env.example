# Token Mapbox (para elevação via Terrain-RGB)
# Obtenha em: https://account.mapbox.com
MAPBOX_TOKEN=pk.SEU_TOKEN_AQUI

# Ambiente
ENV=development

# ── Databricks Community Edition ──────────────────────────────────
# 1. Acesse: https://community.cloud.databricks.com
# 2. Crie um Personal Access Token em Settings > Developer
# 3. Execute o DDL via endpoint GET /api/db/setup-ddl
DATABRICKS_HOST=community.cloud.databricks.com
DATABRICKS_TOKEN=dapi_SEU_TOKEN_AQUI
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/SEU_WAREHOUSE_ID
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=aquacities

# ── NASA FIRMS (optional) ─────────────────────────────────────────
# Active-fire area API. Leave blank to use the public South America CSVs.
# Request a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
